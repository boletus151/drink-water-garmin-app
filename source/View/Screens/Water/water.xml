<layout id="WaterLayout">
    <drawable id="background"/>
    <label id="goal" class="StackText" font="Graphics.FONT_XTINY"
           text="@Strings.GoalLabel" color="0xFFFFFF"
           justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
    <label id="consumed" class="StackText" font="Graphics.FONT_XTINY"
           text="@Strings.ConsumedLabel" color="0xFFFFFF"
           justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
    <label id="schedule" class="StackText" font="Graphics.FONT_XTINY"
           text="09:00 - 21:00 / 30 min" color="0xAAAAAA"
           justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
    <label id="next" class="StackText"
               font="Graphics.FONT_XTINY" text="@Strings.NoNext" color="0xFFFFFF"
           justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
</layout>
