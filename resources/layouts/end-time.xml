<layout id="EndTimeLayout">
    <drawable id="background" class="LayoutBackground">
        <param name="ink">$.Theme.BACKGROUND</param>
    </drawable>
    <label id="title" font="Graphics.FONT_SMALL" class="LayoutText">
        <param name="ink">$.Theme.ACCENT</param>
    </label>
    <drawable id="selection0" class="SelectionBox">
        <param name="target">"digit0"</param>
        <param name="ink">$.Theme.ACCENT</param>
    </drawable>
    <drawable id="selection1" class="SelectionBox">
        <param name="target">"digit1"</param>
        <param name="ink">$.Theme.ACCENT</param>
    </drawable>
    <drawable id="selection2" class="SelectionBox">
        <param name="target">"digit2"</param>
        <param name="ink">$.Theme.ACCENT</param>
    </drawable>
    <drawable id="selection3" class="SelectionBox">
        <param name="target">"digit3"</param>
        <param name="ink">$.Theme.ACCENT</param>
    </drawable>
    <label id="digit0" font="Graphics.FONT_NUMBER_MILD" class="LayoutText">
        <param name="ink">$.Theme.TEXT</param>
        <param name="row">"digits"</param>
        <param name="padding">$.Theme.DIGIT_PADDING</param>
    </label>
    <label id="digit1" font="Graphics.FONT_NUMBER_MILD" class="LayoutText">
        <param name="ink">$.Theme.TEXT</param>
        <param name="row">"digits"</param>
        <param name="padding">$.Theme.DIGIT_PADDING</param>
    </label>
    <label id="separator" font="Graphics.FONT_NUMBER_MILD" text=":" class="LayoutText">
        <param name="ink">$.Theme.TEXT</param>
        <param name="row">"digits"</param>
    </label>
    <label id="digit2" font="Graphics.FONT_NUMBER_MILD" class="LayoutText">
        <param name="ink">$.Theme.TEXT</param>
        <param name="row">"digits"</param>
        <param name="padding">$.Theme.DIGIT_PADDING</param>
    </label>
    <label id="digit3" font="Graphics.FONT_NUMBER_MILD" class="LayoutText">
        <param name="ink">$.Theme.TEXT</param>
        <param name="row">"digits"</param>
        <param name="padding">$.Theme.DIGIT_PADDING</param>
    </label>
    <label id="range" font="Graphics.FONT_XTINY" class="LayoutText">
        <param name="ink">$.Theme.MUTED</param>
    </label>
    <label id="editHint" font="Graphics.FONT_XTINY" text="@Strings.EditHint" class="LayoutText">
        <param name="ink">$.Theme.MUTED</param>
    </label>
    <label id="confirmHint" font="Graphics.FONT_XTINY" class="LayoutText">
        <param name="ink">$.Theme.MUTED</param>
    </label>
</layout>
