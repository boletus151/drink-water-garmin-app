<layout id="WaterLayout">
    <drawable id="background"/>
    <label id="status" x="50%" y="26%" font="Graphics.FONT_XTINY"
           text="@Strings.Enabled" color="0xFFFFFF"
           justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
    <label id="content" x="50%" y="38%" font="Graphics.FONT_XTINY"
           text="2000 ml / dia" color="0xFFFFFF"
           justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
    <label id="schedule" x="50%" y="50%" font="Graphics.FONT_XTINY"
           text="09:00 - 21:00 / 30 min" color="0xAAAAAA"
           justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
    <text-area id="next" x="center" y="55%" width="90%" height="14%"
               font="Graphics.FONT_XTINY" text="@Strings.NoNext" color="0xFFFFFF"
               justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
</layout>
