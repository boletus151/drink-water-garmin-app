<layout id="WaterFrameLayout">
    <!-- Header: shared application title. -->
    <label id="title" class="StackText" font="Graphics.FONT_SMALL"
           text="@Strings.AppTitle" color="0x55FFFF"
           justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>

    <!-- Content: error messages, shown only for invalid settings or scheduling failures. -->
    <label id="errorTitle" class="StackText" font="Graphics.FONT_XTINY"
           text="@Strings.InvalidSettings" color="0xFFAA55"
           justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
    <label id="errorDetail" class="StackText"
               font="Graphics.FONT_XTINY" text="@Strings.ScheduleError" color="0xFFAA55"
               justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>

    <!-- Footer: button hints, hidden on the goal-completed screen. -->
    <label id="toggleHint" class="StackText" font="Graphics.FONT_XTINY"
           text="@Strings.DeactivateHint" color="0xAAAAAA"
           justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
    <label id="menuHint" class="StackText" font="Graphics.FONT_XTINY"
           text="@Strings.MenuHint" color="0xAAAAAA"
           justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
</layout>
