<layout id="MenuItemLayout">
    <drawable id="background"/>
    <drawable id="focus"/>
    <text-area id="label" x="0%" y="0%" width="100%" height="50%"
               font="Graphics.FONT_XTINY" text="@Strings.Interval" color="0xFFFFFF"
               justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
    <text-area id="subLabel" x="0%" y="50%" width="100%" height="50%"
               font="Graphics.FONT_XTINY" text="30" color="0xAAAAAA"
               justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
    <text-area id="navigation" x="0%" y="0%" width="100%" height="100%"
               font="Graphics.FONT_XTINY" text="@Strings.Days" color="0xFFFFFF"
               justification="Graphics.TEXT_JUSTIFY_CENTER | Graphics.TEXT_JUSTIFY_VCENTER"/>
</layout>
